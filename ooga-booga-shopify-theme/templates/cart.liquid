<div class="product-page-main" style="padding: 100px 24px; min-height: 80vh;">
  <div class="product-page-inner" style="max-width: 800px;">
    <div style="background: #fff; border-radius: var(--border-radius-lg); border: var(--border-width-cartoon) solid var(--color-border-cartoon); padding: 40px; box-shadow: var(--shadow-cartoon-lg);">
      <h1 style="font-family: var(--font-display); font-size: 2.8rem; color: var(--color-purple-deep); margin-bottom: 24px;">Your Cart</h1>
      <div id="cartPageList"></div>
      <div style="margin-top: 24px; display: flex; justify-content: space-between; align-items: center; border-top: 2px dashed #ddd; padding-top: 20px;">
        <a href="/" class="btn-cartoon btn-cartoon-yellow">← Continue Browsing</a>
        <button type="button" class="btn-cartoon btn-cartoon-pink" onclick="alert('Proceeding to Checkout!')">Proceed to Checkout</button>
      </div>
    </div>
  </div>
</div>
