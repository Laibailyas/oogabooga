<section class="reviews-section" id="reviews">
  <div class="reviews-header">
    <div class="vintage-comic-tag">
      ★ THE SUBURBAN GAZETTE ★
    </div>
    <h2 class="reviews-title">Praise From Early Readers</h2>
    <p class="shopfront-subtitle">
      Here is what parents, book clubs, and young adventurers are saying about Ooga Booga!
    </p>
  </div>

  <div class="reviews-grid">
    <!-- Review Card 1 -->
    <div class="review-card">
      <div>
        <div class="review-stars">★★★★★</div>
        <p class="review-quote">
          “The artwork feels like a lost classic from the golden age of animation. My 6-year-old insists on reading it every single bedtime without fail!”
        </p>
      </div>
      <div class="reviewer-footer">
        <div class="reviewer-avatar">SP</div>
        <div class="reviewer-meta">
          <span class="reviewer-name">Sarah P. (Melbourne, AU)</span>
          <span class="reviewer-verified">✓ Verified Early Reader</span>
        </div>
      </div>
    </div>

    <!-- Review Card 2 -->
    <div class="review-card">
      <div>
        <div class="review-stars">★★★★★</div>
        <p class="review-quote">
          “Hilarious, wonderfully paced, and packed with charm. The hardcover foil quality is absolutely breathtaking in person. A collector’s dream.”
        </p>
      </div>
      <div class="reviewer-footer">
        <div class="reviewer-avatar">DM</div>
        <div class="reviewer-meta">
          <span class="reviewer-name">David M. (Sydney, AU)</span>
          <span class="reviewer-verified">✓ School Librarian</span>
        </div>
      </div>
    </div>

    <!-- Review Card 3 -->
    <div class="review-card">
      <div>
        <div class="review-stars">★★★★★</div>
        <p class="review-quote">
          “Gianni Dolce Vita created a character that instantly feels iconic. My twins were chanting ‘Ooga Booga!’ all weekend long!”
        </p>
      </div>
      <div class="reviewer-footer">
        <div class="reviewer-avatar">EK</div>
        <div class="reviewer-meta">
          <span class="reviewer-name">Elena K. (Brisbane, AU)</span>
          <span class="reviewer-verified">✓ Verified Parent</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Community Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Praise From Early Readers"
    }
  ]
}
{% endschema %}
